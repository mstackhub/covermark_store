# Turso Database Configuration
# Create database via: turso db create covermark-store --location nrt
# Get URL via: turso db show covermark-store --url
# Create Token via: turso db tokens create covermark-store

TURSO_DATABASE_URL=libsql://covermark-store-YOUR-SUBDOMAIN.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-here

# Server Port (Default: 3000)
PORT=3000
